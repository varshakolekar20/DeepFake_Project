# DeepGuard — Environment Variables Configuration
# Copy this file to .env before starting the server

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false
ENVIRONMENT=production

# Security & CORS
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
SECRET_KEY=deepguard-super-secret-key-change-in-production

# Inference & Hardware Execution
DEVICE=auto  # Options: 'auto', 'cpu', 'cuda'
MAX_IMAGE_SIZE_BYTES=15728640  # 15 MB
MAX_VIDEO_SIZE_BYTES=104857600  # 100 MB
MAX_VIDEO_DURATION_SECONDS=60

# Model Paths
FACIAL_MODEL_WEIGHTS=weights/facial_efficientnet_b0.pt
AIGEN_MODEL_WEIGHTS=weights/aigen_efficientnet_b0.pt

# Quality Heuristic Thresholds
MIN_LAPLACIAN_BLUR_VAR=50.0
MIN_CONTRAST_STD=20.0
MIN_FACE_RESOLUTION=40
